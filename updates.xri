<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <!-- PIAdvisor PixInsight Update Repository -->
   <description>
      <p>PIAdvisor update feed for PixInsight.</p>
      <p>Status: Public package v1.8.1 published on 2026-11-22 02:09:23 UTC.</p>
      <p>Clipboard image paste on Mac, unified shortcuts across all three platforms, and attachment fixes.</p>
      <p>Changelog: https://piadvisor.net/changelog/</p>
   </description>
   <platform os="windows" arch="x64" version="1.8.9:1.9.4">
      <package fileName="packages/PIAdvisor-windows-x64-1.8.1-20261122020635.zip" sha1="9774c1a2dc8f87c7be3192d6ea1e55b3d63ec7e6" releaseDate="20261122020635" type="module">
         <title>PIAdvisor Module v1.8.1</title>
         <remove>bin/PIAdvisor-pxm.dll
bin/PIAdvisor-pxm.xsgn
doc/tools/PIAdvisor/PIAdvisor.html</remove>
         <description>
            <p>Clipboard image paste on Mac, unified shortcuts across all three platforms, and attachment fixes.</p>
            <p>Highlights:</p>
            <p>- On Mac, click the message box and press Cmd+V to paste a screenshot or PNG/JPEG image from the clipboard, matching Windows and Linux.</p>
            <p>- Cmd+Enter and Ctrl+Enter both send on Mac, while Enter and Shift+Enter start a new line.</p>
            <p>- Fixes extended Unicode characters in the message box when sending or editing.</p>
            <p>- Attaching two open views with identical pixels, such as a fresh clone, now keeps a separate draft card for each view.</p>
            <p>Changelog: https://piadvisor.net/changelog/</p>
         </description>
      </package>
   </platform>
