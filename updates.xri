<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <!-- PIAdvisor PixInsight Update Repository -->
   <description>
      <p>PIAdvisor update feed for PixInsight.</p>
      <p>Status: Public package v1.8.0 published on 2026-11-15 22:36:02 UTC.</p>
      <p>Ready for PixInsight 1.9.6 build 1718, with a simpler settings panel and a full account of what PIAdvisor connects to.</p>
      <p>Changelog: https://piadvisor.net/changelog/</p>
   </description>
   <platform os="windows" arch="x64" version="1.8.9:1.9.4">
      <package fileName="packages/PIAdvisor-windows-x64-1.8.0-20261115223602.zip" sha1="5a45ceb4911e06d192c22d32798ef545b4bde454" releaseDate="20261115223602" type="module">
         <title>PIAdvisor Module v1.8.0</title>
         <remove>bin/PIAdvisor-pxm.dll
bin/PIAdvisor-pxm.xsgn
doc/tools/PIAdvisor/PIAdvisor.html</remove>
         <description>
            <p>Ready for PixInsight 1.9.6 build 1718, with a simpler settings panel and a full account of what PIAdvisor connects to.</p>
            <p>Highlights:</p>
            <p>- Advice follows PixInsight 1.9.6 build 1718: plate solving for wide fields and all-sky images, mosaic registration, annotation and sky charts, filter curves from graph images, moving rejected frames in ImageAnalysis, and Cardinal Quintic B-Spline interpolation. On earlier versions, advice uses what those versions have.</p>
            <p>- The settings are now three sections: LLM Settings, Advisor Behavior and Prompts. One section opens at a time, so the panel fits smaller screens. The top of the panel stays in place, and each settings section takes only the height it needs.</p>
            <p>- Images go inside each request. PIAdvisor keeps no files with your AI provider.</p>
            <p>- Connections to other computers use https. Plain http works only for a model server on your own computer.</p>
            <p>- On PixInsight 1.9.6 build 1718 and later, PIAdvisor sends every request through PixInsight&apos;s own network functions.</p>
            <p>- A new help section lists every server PIAdvisor contacts, every program it starts and every file it keeps. The help also carries the acknowledgments for PixInsight and the libraries PIAdvisor uses.</p>
            <p>- New setups start with newer default models. Reasoning effort lists the levels each model accepts, and Default lets the model choose.</p>
            <p>- When you ask for exact settings, PIAdvisor reads PixInsight&apos;s documentation only for the tools that have it, so the answer needs fewer lookups.</p>
            <p>- Fixes for chat formatting.</p>
            <p>Changelog: https://piadvisor.net/changelog/</p>
         </description>
      </package>
   </platform>
