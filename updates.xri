<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <!-- PIAdvisor PixInsight Update Repository -->
   <description>
      <p>PIAdvisor update feed for PixInsight.</p>
      <p>Status: Public package v1.7.1 published on 2026-11-05 02:36:53 UTC.</p>
      <p>Optimized for PixInsight 1.9.6, with advice for more kinds of targets.</p>
      <p>Changelog: https://piadvisor.net/changelog/</p>
   </description>
   <platform os="windows" arch="x64" version="1.8.9:1.9.4">
      <package fileName="packages/PIAdvisor-windows-x64-1.7.1-20261105023426.zip" sha1="6c41cf85124059ff094476ff4d5a7d1206da9db3" releaseDate="20261105023426" type="module">
         <title>PIAdvisor Module v1.7.1</title>
         <remove>bin/PIAdvisor-pxm.dll
bin/PIAdvisor-pxm.xsgn
doc/tools/PIAdvisor/PIAdvisor.html</remove>
         <description>
            <p>Optimized for PixInsight 1.9.6, with advice for more kinds of targets.</p>
            <p>Highlights:</p>
            <p>- Optimized for the new PixInsight 1.9.6 processes, such as MultiscaleTGVDenoise and ImageAnalysis, and tool links open the new 1.9.6 scripts. On earlier versions, advice uses the processes those versions have.</p>
            <p>- Workflow advice follows the 1.9.6 documentation for noise reduction, gradient correction, plate solving, image weights, WBPP results and narrowband color calibration.</p>
            <p>- Installed third-party sharpening and noise-reduction tools each get their own settings, with PixInsight&apos;s own processes as the alternative. Each reply keeps one processing order.</p>
            <p>- New advice for comets, mosaics, solar and lunar images, and bright cores, with PixInsight&apos;s own tools.</p>
            <p>- Improved interpretation of processing history and refined star-sampling guidance.</p>
            <p>Changelog: https://piadvisor.net/changelog/</p>
         </description>
      </package>
   </platform>
