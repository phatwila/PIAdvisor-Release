<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <!-- PIAdvisor PixInsight Update Repository -->
   <description>
      <p>PIAdvisor update feed for PixInsight.</p>
      <p>Status: Public package v1.4.0 published on 2026-10-04 20:50:07 UTC.</p>
      <p>Modernized support for all four AI providers, with clearer and more reliable responses.</p>
      <p>Changelog: https://piadvisor.net/changelog/</p>
   </description>
   <platform os="windows" arch="x64" version="1.8.9:1.9.4">
      <package fileName="packages/PIAdvisor-windows-x64-1.4.0-20261004204852.zip" sha1="81136bfa4f24b81a9b0e778f123ccaae55fdc8b3" releaseDate="20261004204852" type="module">
         <title>PIAdvisor Module v1.4.0</title>
         <remove>bin/PIAdvisor-pxm.dll
bin/PIAdvisor-pxm.xsgn
doc/tools/PIAdvisor/PIAdvisor.html</remove>
         <description>
            <p>Modernized support for all four AI providers, with clearer and more reliable responses.</p>
            <p>Highlights:</p>
            <p>- Modernized support for OpenAI, Gemini, OpenRouter, and OpenAI-compatible local servers. Saved models, keys, endpoints, and prompts carry over unchanged.</p>
            <p>- Model-aware requests: PIAdvisor matches the token limit, reasoning effort, temperature, and image support to the selected model. If a model cannot read images, PIAdvisor says so instead of showing a provider error.</p>
            <p>- Clearer outcomes: refusals, exhausted output budgets, interrupted streams, rate limits, and provider overloads each show a plain message. A provider that completes with no text shows a notice instead of an empty reply.</p>
            <p>- When a reply fails partway, including during an automatic continuation, the text received so far stays in the conversation.</p>
            <p>- Cancel stops stalled requests within seconds, even when the server goes silent. A chat turn stops after 5 minutes, and a connection test after 60 seconds.</p>
            <p>- Test Connection now checks that the selected model returns a real answer.</p>
            <p>- Model suggestions now list current models for each provider, and model lists show when they come from the cache.</p>
            <p>- Local servers: PIAdvisor recognizes Ollama, reads each model&apos;s capabilities, and selects the only available chat model when none is chosen. It never downloads models, and new local configurations no longer start with a preset model name.</p>
            <p>- Export can save provider metadata only (models, timing, token usage, and outcome) as JSON, without prompts or replies.</p>
            <p>- Supports PixInsight 1.9.5 and PixInsight 1.8.9 through 1.9.4, with a separate build for each. PixInsight 1.9.4 users move from PIAdvisor 1.3.0 to 1.4.0.</p>
            <p>- SubframeSelector settings in processing-history previews require PixInsight 1.9.5. Earlier versions list SubframeSelector steps without their settings, as in 1.3.0.</p>
            <p>Changelog: https://piadvisor.net/changelog/</p>
         </description>
      </package>
   </platform>
