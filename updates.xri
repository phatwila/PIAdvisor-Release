<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <!-- PIAdvisor PixInsight Update Repository -->
   <description>
      <p>PIAdvisor update feed for PixInsight.</p>
      <p>Status: Public package v1.6.0 published on 2026-10-18 02:52:35 UTC.</p>
      <p>PIAdvisor now runs on Mac. This release also sends sharper images to the advisor, reuses uploaded images on supported connections, and allows more measurements in each round.</p>
      <p>Changelog: https://piadvisor.net/changelog/</p>
   </description>
   <platform os="windows" arch="x64" version="1.8.9:1.9.4">
      <package fileName="packages/PIAdvisor-windows-x64-1.6.0-20261018025120.zip" sha1="2ac6fa0fb44933bb2d0ddedd7d10a899c4510eef" releaseDate="20261018025120" type="module">
         <title>PIAdvisor Module v1.6.0</title>
         <remove>bin/PIAdvisor-pxm.dll
bin/PIAdvisor-pxm.xsgn
doc/tools/PIAdvisor/PIAdvisor.html</remove>
         <description>
            <p>PIAdvisor now runs on Mac. This release also sends sharper images to the advisor, reuses uploaded images on supported connections, and allows more measurements in each round.</p>
            <p>Highlights:</p>
            <p>- PIAdvisor now runs on Mac computers with Apple silicon in PixInsight 1.9.5 or later, alongside Windows and Linux. Install and update it from the same PixInsight repository. PIAdvisor does not support Intel Macs. If you need Intel Mac support, tell us at support@piadvisor.net.</p>
            <p>- Attach View renders the part of the image you see from the image&apos;s own pixels and screen stretch. Previews and busy views attach the screen view instead.</p>
            <p>- Pro now offers Full resolution. Supported models receive images up to 6000 pixels on the longest side. Other models receive images up to 2048 pixels. The advisor sees fine detail such as star shapes in the corners and noise in faint areas.</p>
            <p>- Supported connections reuse uploaded images in later messages. PIAdvisor asks the provider to delete uploaded images when they leave the chat, and the images expire after 24 hours. You can turn this off in LLM Settings.</p>
            <p>- Attached views show their history step and the last process, so the advisor can tell two states of the same image apart.</p>
            <p>- Pro and Trial allow up to 32 measurements per round. That fits stars, background and FITS-header checks on each of five masters in one round.</p>
            <p>- Every edition can set Tool rounds to 0 for answers without measurements. Free allows 0 to 2 measuring rounds per answer, with up to 6 measurements in each round.</p>
            <p>- Export Chat adds the export date, PIAdvisor version, edition, and current provider and model beneath the title.</p>
            <p>- Better advice for HaRGB combination, gradient correction after color calibration, and loading process settings.</p>
            <p>- Fixes for window sizing and processing history details.</p>
            <p>Changelog: https://piadvisor.net/changelog/</p>
         </description>
      </package>
   </platform>
