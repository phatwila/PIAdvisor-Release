<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <!-- PIAdvisor PixInsight Update Repository -->
   <description>
      <p>PIAdvisor update feed for PixInsight.</p>
      <p>Status: Public package v1.7.0 published on 2026-10-27 21:33:10 UTC.</p>
      <p>Smarter, more accurate processing advice. The advisor measures lightness, tests curves before you apply them, reads PixInsight&apos;s process documentation, and uses your installed processes and discovered scripts to guide recommendations.</p>
      <p>Changelog: https://piadvisor.net/changelog/</p>
   </description>
   <platform os="windows" arch="x64" version="1.8.9:1.9.4">
      <package fileName="packages/PIAdvisor-windows-x64-1.7.0-20261027213232.zip" sha1="881afa40c7fb44b87acf7cb27abb5c7171ef33e3" releaseDate="20261027213232" type="module">
         <title>PIAdvisor Module v1.7.0</title>
         <remove>bin/PIAdvisor-pxm.dll
bin/PIAdvisor-pxm.xsgn
doc/tools/PIAdvisor/PIAdvisor.html</remove>
         <description>
            <p>Smarter, more accurate processing advice. The advisor measures lightness, tests curves before you apply them, reads PixInsight&apos;s process documentation, and uses your installed processes and discovered scripts to guide recommendations.</p>
            <p>Highlights:</p>
            <p>- Lightness (CIE L*) measurements for masks, curves and stretches.</p>
            <p>- Test a curve through the image&apos;s mask before you apply it. Pro also tests another open mask before you assign it, and compares up to three curves.</p>
            <p>- Parameter advice follows PixInsight&apos;s process documentation when it is installed. Free and Pro.</p>
            <p>- Choose the reasoning effort on models that offer it. OpenAI models use your OpenAI key directly, with an estimated cost on each reply.</p>
            <p>- Each process or script the advisor names is linked on its first mention in a reply.</p>
            <p>- Try every Pro feature free for 30 days.</p>
            <p>- Settings come from your image&apos;s current measurements when they can be measured; otherwise the advisor explains how to find them.</p>
            <p>- Next steps start from what the image needs, its history and your earlier choices.</p>
            <p>- Suggestions follow your installation: a suitable native process first, then installed alternatives.</p>
            <p>- Trials stay on your working image, so the undo history stays in one place.</p>
            <p>- Follow-ups keep earlier measurements, and questioned advice gets rechecked first.</p>
            <p>- Better advice for stretching, black points, masks, star recombination and background color.</p>
            <p>- Many fixes, including measurement statistics, mask state in large workspaces and cost lines on OpenRouter.</p>
            <p>Changelog: https://piadvisor.net/changelog/</p>
         </description>
      </package>
   </platform>
